# Supabase connection strings:
# DATABASE_URL: Transaction Pooler (port 6543) for Vercel/serverless runtime.
# DIRECT_DATABASE_URL: Session Pooler (port 5432) for Prisma migrations.
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<SUPABASE_PASSWORD>@<POOLER_HOST>:6543/postgres?sslmode=require"
DIRECT_DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<SUPABASE_PASSWORD>@<POOLER_HOST>:5432/postgres?sslmode=require"
NEXT_PUBLIC_SUPABASE_URL="https://qwpbusaissuysryzbzbi.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<SUPABASE_PUBLISHABLE_KEY>"
SUPABASE_SERVICE_ROLE_KEY="<SUPABASE_SERVICE_ROLE_KEY>"
SUPABASE_PRODUCT_IMAGE_BUCKET="product-images"
RAZORPAY_KEY_ID="<RAZORPAY_LIVE_KEY_ID>"
RAZORPAY_KEY_SECRET="<RAZORPAY_LIVE_KEY_SECRET>"
# Set this to a separate random secret configured in the Razorpay Dashboard webhook settings.
RAZORPAY_WEBHOOK_SECRET="<RAZORPAY_WEBHOOK_SECRET>"